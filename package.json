{
  "name": "zero-launcher",
  "version": "1.0.0",
  "description": "Zero Launcher - Hesapsız, çevrimdışı Minecraft Java launcher (Vanilla, Fabric, Forge, NeoForge)",
  "main": "main.js",
  "author": "Zero Launcher",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "adm-zip": "^0.5.16"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.zero.launcher",
    "productName": "Zero Launcher",
    "directories": { "output": "dist" },
    "files": ["main.js", "core.js", "preload.js", "src/**/*", "build/icon.png", "package.json"],
    "win": {
      "icon": "build/icon.png",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Zero-Launcher-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Zero-Launcher-Portable-${version}.exe"
    }
  }
}
